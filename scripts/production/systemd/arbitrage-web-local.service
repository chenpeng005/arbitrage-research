[Unit]
Description=Arbitrage Runtime Web Local 7080
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/projects/arbitrage-runtime
ExecStart=/home/admin/bin/arbitrage-web-local.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
