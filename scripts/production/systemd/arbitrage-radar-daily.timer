[Unit]
Description=Run formal Intelligence Radar daily at 23:03 Asia/Shanghai

[Timer]
# Production schedule: formal API-mode Radar run after daytime Xueqiu accumulation.
# 23:03 (moved from 21:03 on 2026-10-27) keeps the run on the same calendar day
# while capturing evening disclosures up to 23:00.
OnCalendar=*-*-* 23:03:00 Asia/Shanghai
Persistent=true
AccuracySec=1min
Unit=arbitrage-radar-daily.service

[Install]
WantedBy=timers.target
