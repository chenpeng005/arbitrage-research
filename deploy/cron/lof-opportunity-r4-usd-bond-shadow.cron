# R4 501300 USD-bond shadow-only watchdog. Never feeds main estimated NAV.
# Install into admin user's crontab; flock guarantees a single long-running sampler.
* * * * * /usr/bin/flock -n /home/admin/projects/lof-opportunity-runtime/r4-usd-bond-shadow/runner.lock /bin/bash -lc 'cd /home/admin/projects/lof-opportunity-runtime/r4-usd-bond-shadow/current && exec /home/admin/projects/lof-opportunity-runtime/.venv/bin/python -m runtime.lof.r4_usd_bond_shadow_runner --main-data-root /home/admin/projects/lof-opportunity-runtime/runtime_data --state-root /home/admin/projects/lof-opportunity-runtime/runtime_data/r4_usd_bond_shadow --loop --quote-interval-seconds 30 --off-hours-interval-seconds 300 --timeout 6 --max-input-age-seconds 1800 >> /home/admin/projects/lof-opportunity-runtime/logs/r4-usd-bond-shadow.log 2>&1'
