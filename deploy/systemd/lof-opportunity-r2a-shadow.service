[Unit]
Description=LOF R2-A Holdings Basket Shadow
After=network-online.target lof-opportunity-updater.service
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/projects/lof-opportunity-runtime/r2a-shadow/current
Environment=PYTHONPATH=/home/admin/projects/lof-opportunity-runtime/r2a-shadow/current
Environment=LOF_RUNTIME_DATA_ROOT=/home/admin/projects/lof-opportunity-runtime/runtime_data
ExecStart=/home/admin/projects/lof-opportunity-runtime/.venv/bin/python -m runtime.lof.r2a_shadow --data-root /home/admin/projects/lof-opportunity-runtime/runtime_data --loop --quote-interval-seconds 30 --off-hours-interval-seconds 300 --holdings-refresh-seconds 21600 --timeout 6 --max-quote-age-seconds 120
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
