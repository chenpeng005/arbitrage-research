{
	auto_https disable_redirects
	default_sni 47.109.176.100
}

https://47.109.176.100:8443 {
	tls internal

	route {
		@runtime path /runtime/*
		handle @runtime {
			uri strip_prefix /runtime
			reverse_proxy 127.0.0.1:8010
		}

		@admin_pages path /run-center /audit /review /workbench
		handle @admin_pages {
			basic_auth {
				{$CADDY_ADMIN_USER} {$CADDY_ADMIN_HASH}
			}
			reverse_proxy 127.0.0.1:7080 {
				header_up Host 127.0.0.1:3080
				header_up X-Runtime-Proxy caddy-admin
			}
		}

		@admin_get_api path /api/market-map/history /api/chat-tasks/* /api/opportunity/storage-status /api/opportunity/storage-cutover-readiness /api/opportunity/information-status /api/opportunity/full-runs/latest /api/runs/* /api/opportunity/market-ingress/latest /api/opportunity/candidate-pool/latest /api/opportunity/records/latest /api/opportunity/records/* /api/market-status
		handle @admin_get_api {
			basic_auth {
				{$CADDY_ADMIN_USER} {$CADDY_ADMIN_HASH}
			}
			reverse_proxy 127.0.0.1:7080 {
				header_up Host 127.0.0.1:3080
				header_up X-Runtime-Proxy caddy-admin
			}
		}

		@writes method POST PUT PATCH DELETE
		handle @writes {
			basic_auth {
				{$CADDY_ADMIN_USER} {$CADDY_ADMIN_HASH}
			}
			reverse_proxy 127.0.0.1:7080 {
				header_up Host 127.0.0.1:3080
				header_up X-Runtime-Proxy caddy-admin
			}
		}

		handle {
			reverse_proxy 127.0.0.1:7080 {
				header_up Host 127.0.0.1:3080
				header_up X-Runtime-Proxy caddy-public
			}
		}
	}
}
